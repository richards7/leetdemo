# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Canonical production origin used in sitemap, robots.txt, and self-referential links.
# Set this in Vercel to the HTTPS custom domain, for example https://www.example.com.
APP_URL="https://your-production-domain.com"

# GOOGLE_SERVICE_ACCOUNT_JSON: Full Google Service Account credentials JSON string.
# Obtained from Google Cloud Console > Service Accounts > Keys > Add Key (JSON).
# Example: {"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...","client_email":"...iam.gserviceaccount.com",...}
GOOGLE_SERVICE_ACCOUNT_JSON=""

# GOOGLE_SHEET_ID: The Google Sheets spreadsheet ID (from the spreadsheet URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit).
GOOGLE_SHEET_ID=""

# GOOGLE_SHEET_TAB_NAME: Optional sheet/tab name inside the spreadsheet. Defaults to "Consultation Inquiries".
GOOGLE_SHEET_TAB_NAME="Consultation Inquiries"

# Student Project Hub: deployed Google Apps Script web app URL.
STUDENT_PROJECT_APPS_SCRIPT_URL="https://script.google.com/macros/s/AKfycbwqueXSHPz7zT0ovphTJoyShKLTUnEBjbII2s_fmMFuappfogakX1oDza7T9U3MyZcx/exec"
# Optional direct service-account fallback (uses the existing credentials above).
STUDENT_PROJECT_SHEET_ID=""
STUDENT_PROJECT_SHEET_TAB_NAME="Submissions"

# Blog CMS PostgreSQL database. Keep this server-side only.
DATABASE_URL="postgresql://user:password@host:5432/rovianx_blog"

# Blog featured-image storage (Cloudinary). Keep these server-side only.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
